# Simple two-stage build for the agents favicon directory (adapter-node server).
# Mirrors the pillardash Dockerfile pattern: Bun for build and runtime.

# Build stage
FROM oven/bun:1-slim AS builder

WORKDIR /app

# Workspace manifests first, so bun install can resolve every workspace.
COPY package.json bun.lock ./
COPY apps/agents-favicon/package.json ./apps/agents-favicon/
COPY apps/marketing/package.json ./apps/marketing/

RUN bun install --frozen-lockfile

COPY apps/agents-favicon ./apps/agents-favicon
RUN bun run --cwd apps/agents-favicon build
RUN DATA_DIR=/app/data bun run --cwd apps/agents-favicon scripts/seed.ts

# Run stage — Bun serves the adapter-node bundle.
FROM oven/bun:1-slim

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV DATA_DIR=/app/data
ENV MIGRATIONS_DIR=/app/apps/agents-favicon/drizzle

# Production deps for the app workspace.
COPY package.json bun.lock ./
COPY apps/agents-favicon/package.json ./apps/agents-favicon/
COPY apps/marketing/package.json ./apps/marketing/
RUN bun install --frozen-lockfile --omit=dev

# Server bundle + SQL migrations + the seeded database from the build stage.
COPY --from=builder /app/apps/agents-favicon/build ./apps/agents-favicon/build
COPY --from=builder /app/apps/agents-favicon/drizzle ./apps/agents-favicon/drizzle
COPY --from=builder /app/data ./data

EXPOSE 3000

CMD ["bun", "./apps/agents-favicon/build/index.js"]
