# Build stage
FROM oven/bun:1-slim AS builder

WORKDIR /app

# Workspace manifests first, so bun install can resolve every workspace.
COPY package.json bun.lock ./
COPY apps/marketing/package.json ./apps/marketing/

RUN bun install --frozen-lockfile

COPY apps/marketing ./apps/marketing
RUN bun run --cwd apps/marketing build

# Production stage — Bun serves the SvelteKit output.
FROM oven/bun:1-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/apps/marketing/build ./build
COPY --from=builder /app/apps/marketing/package.json ./package.json

EXPOSE 3000

CMD ["bun", "./build/index.js"]
