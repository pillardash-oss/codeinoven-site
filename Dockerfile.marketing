# Simple two-stage build for the marketing site (prerendered static output).

# Build stage
FROM oven/bun:1-slim AS builder

WORKDIR /app

# Workspace manifests first, so bun install can resolve every workspace.
COPY package.json bun.lock ./
COPY apps/marketing/package.json ./apps/marketing/
COPY apps/agents-favicon/package.json ./apps/agents-favicon/

RUN bun install --frozen-lockfile

COPY apps/marketing ./apps/marketing
RUN bun run --cwd apps/marketing build

# Serve the prerendered site as plain static files.
FROM nginx:alpine

COPY --from=builder /app/apps/marketing/build /usr/share/nginx/html

EXPOSE 80
