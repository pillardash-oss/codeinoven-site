# CodeInOven website — environment variables
#
# Copy to `.env` for local development. Never commit a real `.env`.
# Production values live in Coolify project environment variables.

# The site is fully prerendered, so the app itself needs no environment
# variables. These configure the generated Bun server at runtime instead.

# Public origin of the deployment. Only needed behind a reverse proxy that
# does not send X-Forwarded-Proto / X-Forwarded-Host.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Server port (the Dockerfile sets 3000).
# PORT=3000

# Host to bind to.
# HOST=0.0.0.0

# Raise the per-request body limit, which defaults to 512K.
# BODY_SIZE_LIMIT=1M
