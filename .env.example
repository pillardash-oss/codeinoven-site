# CodeInOven website — environment variables
#
# Copy to `.env` for local development. Never commit a real `.env`.
# Production values live in Coolify project environment variables.

# --- apps/agents-favicon (node server) ---
# Public origin of the deployment (used by adapter-node). Required.
# ORIGIN=https://codeinoven.dev

# SQLite data directory inside the container (persisted volume).
# DATA_DIR=/app/data

# Optional: GitHub token to raise API rate limits for the icon crawler.
# GITHUB_TOKEN=

# Enable the daily crawl cron inside the container. Set false to use a
# Coolify scheduled task instead.
# ENABLE_CRON=true
# CRAWL_CRON=0 4 * * *

# Server port (Dockerfile default 3000).
# PORT=3000

# --- apps/marketing (static, no env) ---
# The marketing site is fully static; no environment variables required.
